# Copy this file to .env and fill in your values.

# The same Apps Script Web App URL your Apify actor already posts jobs to
# (from googleAppsScriptUrl in the Apify actor input). Must be the UPDATED
# script from apps_script.gs, redeployed as a new version.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycby8VECxNiArd4qHi9s70poirp6uOGQVTYSHbpMlOaEEAsu55UphLDITI2uFJh7cgTA/exec

# Optional: where Playwright keeps your logged-in Chrome session.
# Defaults to ~/.linkedin-apply-bot-profile if not set.
CHROME_PROFILE_DIR=/Users/saadshaikh/.linkedin-apply-bot-profile
